# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=30d

# ── Frontend URL (your deployed frontend domain) ─────────
FRONTEND_URL=https://your-frontend-domain.com

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Twilio SMS ───────────────────────────────────────────
# Get from: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Admin ────────────────────────────────────────────────
ADMIN_EMAIL=admin@nansaiorganics.com

# ── Shiprocket (automatic shipping + tracking) ───────────
# Leave SHIPROCKET_EMAIL empty to switch the whole thing off — orders then work exactly as before.
# Use a dedicated API user: Shiprocket → Settings → API → Create API User (not your main login).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname exactly as it appears in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# "false" = only create the order in Shiprocket and buy the label yourself (nothing is charged automatically)
SHIPROCKET_AUTO_SHIP=true
# Any long random string. Enter the SAME value in Shiprocket's webhook settings (the "token" / x-api-key field).
SHIPROCKET_WEBHOOK_TOKEN=
# Parcel defaults (kg / cm). Weight is worked out from the ordered quantities; these are fallbacks.
SHIPROCKET_MIN_WEIGHT=0.5
SHIPROCKET_PIECE_WEIGHT=0.05
SHIPROCKET_LENGTH=20
SHIPROCKET_BREADTH=15
SHIPROCKET_HEIGHT=10
